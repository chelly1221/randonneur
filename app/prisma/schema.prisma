generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp")]
}

model Course {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseNumber  String?  @map("course_number") // unique only for active courses (partial index in DB)
  name          String
  distanceKm    Float    @map("distance_km")
  elevationM    Int      @map("elevation_m")
  estimatedTime String?  @map("estimated_time")
  startLocation String   @map("start_location")
  endLocation   String   @map("end_location")
  region        String?
  category      String[] @default([])
  tags          String[] @default([])
  description   String?
  designer      String?
  gpxFileKey    String?  @map("gpx_file_key")
  officialPageUrl String? @map("official_page_url")
  archived      Boolean  @default(false)
  country       String?  // 'KR', 'AU', etc.
  sourceType    String?  @map("source_type") // 'audax-au' for scraped, null for manual
  externalId    String?  @map("external_id") // 'audax-au-{rideId}' for dedup
  geom          Unsupported("geometry(LineString, 4326)")?
  elevationProfile Json? @map("elevation_profile") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  completions          Completion[]
  downloads            Download[]
  checkpoints          Checkpoint[]
  favorites            Favorite[]
  reviews              Review[]
  improvementRequests  ImprovementRequest[]
  journals             Journal[]
  seasonalPicks        SeasonalPick[]
  events               Event[]

  @@unique([sourceType, externalId])
  @@index([country])
  @@map("courses")
}

model User {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  keycloakId  String   @unique @map("keycloak_id")
  displayName String   @map("display_name")
  email       String   @unique
  role        String   @default("user")
  bio         String?
  avatarKey   String?  @map("avatar_key")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  completions                Completion[]
  favorites                  Favorite[]
  reviews                    Review[]
  improvementRequests        ImprovementRequest[]
  checkpointPhotoSubmissions CheckpointPhotoSubmission[]
  comments                   Comment[]
  likes                      Like[]
  reports                    Report[]
  userBadges                 UserBadge[]
  pushSubscriptions          PushSubscription[]
  followers                  Follow[]  @relation("UserFollowers")
  following                  Follow[]  @relation("UserFollowing")
  bikes                      Bike[]
  journals                   Journal[]
  reviewPhotos               ReviewPhoto[]
  sharedRoutes               SharedRoute[]
  events                     Event[]
  eventParticipations        EventParticipant[]
  polls                      Poll[]
  pollVotes                  PollVote[]
  notifications              Notification[]
  auditLogs                  AuditLog[]

  @@map("users")
}

model Completion {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  completedAt      DateTime @map("completed_at")
  completionStatus String   @default("success") @map("completion_status")
  gpxFileKey       String?  @map("gpx_file_key")
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([completedAt])
  @@map("completions")
}

model Download {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  downloadedAt DateTime @default(now()) @map("downloaded_at")
  ipHash       String?  @map("ip_hash")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("downloads")
}

model Checkpoint {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseId     String  @map("course_id") @db.Uuid
  name        String
  description String?
  distanceKm  Float   @map("distance_km")
  imageKey    String? @map("image_key")
  sortOrder   Int     @default(0) @map("sort_order")

  course           Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  photoSubmissions CheckpointPhotoSubmission[]

  @@map("checkpoints")
}

model Favorite {
  id       String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  courseId  String @map("course_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("favorites")
}

model Setting {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Review {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  courseId         String   @map("course_id") @db.Uuid
  completionStatus String   @default("completed") @map("completion_status")
  difficulty       String?
  content          String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  reports  Report[]
  photos   ReviewPhoto[]

  @@index([userId])
  @@index([createdAt])
  @@map("reviews")
}

model Comment {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review   Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  children Comment[] @relation("CommentReplies")
  likes    Like[]
  reports  Report[]

  @@index([reviewId])
  @@index([parentId])
  @@map("comments")
}

model Like {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  reviewId  String?  @map("review_id") @db.Uuid
  commentId String?  @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review  Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@unique([userId, commentId])
  @@index([reviewId])
  @@index([commentId])
  @@map("likes")
}

model ImprovementRequest {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  category  String?  @map("category")
  content   String
  status    String   @default("pending")
  adminNote String?  @map("admin_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("improvement_requests")
}

model CheckpointPhotoSubmission {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  checkpointId String   @map("checkpoint_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  imageKey     String   @map("image_key")
  status       String   @default("pending")
  adminNote    String?  @map("admin_note")
  createdAt    DateTime @default(now()) @map("created_at")

  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("checkpoint_photo_submissions")
}

model Report {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reviewId   String?  @map("review_id") @db.Uuid
  commentId  String?  @map("comment_id") @db.Uuid
  reason     String
  detail     String?
  status     String   @default("pending")
  adminNote  String?  @map("admin_note")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  reporter User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  review   Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("reports")
}

model Badge {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug        String   @unique
  name        String
  description String
  icon        String
  criteria    Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ========================================
// New community feature models
// ========================================

model Follow {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Bike {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  brand     String?
  model     String?
  year      Int?
  type      String?  // road, gravel, touring, etc.
  imageKey  String?  @map("image_key")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("bikes")
}

model Journal {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  courseId   String?   @map("course_id") @db.Uuid
  title     String
  content   String
  rideDate  DateTime? @map("ride_date")
  distance  Float?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  photos JournalPhoto[]

  @@index([userId])
  @@index([createdAt])
  @@map("journals")
}

model JournalPhoto {
  id        String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  journalId String  @map("journal_id") @db.Uuid
  imageKey  String  @map("image_key")
  caption   String?
  sortOrder Int     @default(0) @map("sort_order")

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([journalId])
  @@map("journal_photos")
}

model ReviewPhoto {
  id        String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reviewId  String  @map("review_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  imageKey  String  @map("image_key")
  caption   String?
  sortOrder Int     @default(0) @map("sort_order")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_photos")
}

model SharedRoute {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  title         String
  description   String?
  distance      Float?
  elevation     Float?
  region        String?
  gpxFileKey    String   @map("gpx_file_key")
  downloadCount Int      @default(0) @map("download_count")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("shared_routes")
}

model SeasonalPick {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  season      String   // spring, summer, autumn, winter
  year        Int
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, season, year])
  @@map("seasonal_picks")
}

model Event {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  title           String
  description     String?
  eventType       String    @map("event_type") // brevet, group_ride, festival, other
  courseId         String?   @map("course_id") @db.Uuid
  location        String?
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  maxParticipants Int?      @map("max_participants")
  sourceType      String?   @map("source_type") // "acp" or null (manual)
  externalId      String?   @map("external_id") // dedup key, e.g. "acp-2026-0307-korea-seoul-200"
  sourceUrl       String?   @map("source_url") // link to source page
  country         String?   @map("country") // ACP country name, e.g. "Korea", "France"
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  participants EventParticipant[]

  @@unique([sourceType, externalId])
  @@index([startDate])
  @@index([userId])
  @@index([country])
  @@map("events")
}

model EventParticipant {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("going") // going, interested, cancelled
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_participants")
}

model Poll {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  endsAt      DateTime? @map("ends_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@index([createdAt])
  @@map("polls")
}

model PollOption {
  id        String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pollId    String @map("poll_id") @db.Uuid
  label     String
  sortOrder Int    @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@map("poll_votes")
}

model Notification {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   // comment, follow, event_reminder, like, completion
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?    @db.JsonB
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
