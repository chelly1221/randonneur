# Caddy reverse proxy — shared proxy stack for the single Hetzner VM.
# Caddy obtains and renews Let's Encrypt certificates automatically and
# injects X-Forwarded-* / X-Real-IP headers for each upstream app.
#
# Each service stack joins the external 'web' network and exposes its app
# container under a network alias ({service}-app). Add a site block here
# per domain, then reload:  docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

{
	# ACME account email — used for cert-expiry notices.
	email server.chelly.kr@gmail.com
}

# ── audax.3chan.kr : Randonneur platform ───────────────────────────────
audax.3chan.kr {
	encode zstd gzip
	reverse_proxy audax-app:3000
}

# ── cycle.3chan.kr : Personal cycling archive ──────────────────────────
cycle.3chan.kr {
	encode zstd gzip
	reverse_proxy cycle-app:3000
}

# ── nextcloud.3chan.kr : Nextcloud ─────────────────────────────────────
nextcloud.3chan.kr {
	encode zstd gzip
	# DAV service discovery — keep the redirect on https (the container's
	# own .htaccess would emit an http:// Location behind the proxy).
	redir /.well-known/carddav /remote.php/dav/ 301
	redir /.well-known/caldav /remote.php/dav/ 301
	reverse_proxy nextcloud-app:80
}

# ── Future services ────────────────────────────────────────────────────
# Add each new service as its own site block, joined to the 'web' network
# with a {service}-app alias. Example:
#
# service-c.3chan.kr {
#	encode zstd gzip
#	reverse_proxy service-c-app:3000
# }
