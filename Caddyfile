# Caddy reverse proxy — single-VM production deployment.
# Caddy obtains and renews Let's Encrypt certificates automatically and
# injects X-Forwarded-* / X-Real-IP headers for the upstream app.

{
	# ACME account email — used for cert-expiry notices. Set before deploying.
	email YOUR_EMAIL@example.com
}

# ── audax.3chan.kr : Randonneur platform ───────────────────────────────
audax.3chan.kr {
	encode zstd gzip
	reverse_proxy app:3000
}

# ── Future services ────────────────────────────────────────────────────
# Add each new service as its own site block. Caddy handles TLS for every
# domain automatically. Example:
#
# service-b.example.com {
#	encode zstd gzip
#	reverse_proxy service-b:3000
# }
