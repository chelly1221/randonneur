# PostgreSQL
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=randonneur
# Host is the compose service name `postgres`. URL-encode special chars
# in the password (e.g. && -> %26%26).
DATABASE_URL=postgresql://your_user:your_password@postgres:5432/randonneur

# Auth.js — login is direct via Google + Naver OAuth (no Keycloak)
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET=generate_a_secret_here
NEXTAUTH_URL=https://audax.3chan.kr
# Google: console.cloud.google.com
#   Authorized redirect URI: https://audax.3chan.kr/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Naver: developers.naver.com
#   Callback URL: https://audax.3chan.kr/api/auth/callback/naver
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=gpx-files

# Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Next.js
NODE_ENV=production
